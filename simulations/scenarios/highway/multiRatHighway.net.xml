<?xml version="1.0" encoding="UTF-8"?>
<!--
    MultiRatVanet straight-highway SUMO network.

    A 2000 m, two-lane, bidirectional straight road centred on y = 100 m so that
    it aligns with the WiFi APs / DSRC RSUs placed along y = 100 m (x = 300..1400)
    in simulations/omnetpp.ini. Vehicles travelling along x therefore drive in and
    out of each RAT's coverage, exercising the handover framework.

    netOffset is 0,0 so SUMO (x,y) map directly to OMNeT/INET coordinates
    (fine-tune AP/RSU positions or the Veins manager margin if needed).
-->
<net version="1.9" junctionCornerDetail="5" limitTurnSpeed="5.50" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">

    <location netOffset="0.00,0.00" convBoundary="0.00,0.00,2000.00,100.00" origBoundary="0.00,0.00,2000.00,100.00" projParameter="!"/>

    <edge id="E0" from="J0" to="J1" priority="-1">
        <lane id="E0_0" index="0" speed="27.78" length="2000.00" shape="0.00,96.80 2000.00,96.80"/>
        <lane id="E0_1" index="1" speed="27.78" length="2000.00" shape="0.00,100.00 2000.00,100.00"/>
    </edge>
    <edge id="E1" from="J1" to="J0" priority="-1">
        <lane id="E1_0" index="0" speed="27.78" length="2000.00" shape="2000.00,103.20 0.00,103.20"/>
        <lane id="E1_1" index="1" speed="27.78" length="2000.00" shape="2000.00,106.40 0.00,106.40"/>
    </edge>

    <junction id="J0" type="dead_end" x="0.00" y="100.00" incLanes="E1_0 E1_1" intLanes="" shape="0.00,95.20 0.00,108.00"/>
    <junction id="J1" type="dead_end" x="2000.00" y="100.00" incLanes="E0_0 E0_1" intLanes="" shape="2000.00,108.00 2000.00,95.20"/>

</net>
