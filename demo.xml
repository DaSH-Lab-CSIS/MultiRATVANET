<config>
    <!-- INET Ipv4NetworkConfigurator config for the MultiRatHighway network.
         The Simu5G NR/cars Highway hard-assigns configurator.config =
         xmldoc("demo.xml"), resolved relative to the run working directory
         (the repo root). gNodeBs/UEs get 10.x.x.x on their cellular interface;
         everything else gets 192.168.x.x. -->
    <interface hosts="gNodeB*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="ue*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="*" address="192.168.x.x" netmask="255.255.255.0"/>
</config>
