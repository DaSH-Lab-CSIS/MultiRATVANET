+// DaSH patch: see the declaration in BearerConfigurator.h. Authors the onDemandDrbs
+// definitions for one UE that registered after configureDrbs() ran. Only onDemandDrbs
+// are handled (staticDrbs are established up front and name their UE explicitly).
+// Limitation: an onDemandDrbs entry with a "ue" pattern that does not match this UE
+// makes parseDrbDefinitions() raise its usual "matches no registered UE" error.
+void BearerConfigurator::ensureBearersAuthored(cModule *ueModule)
+{
+    if (ueModule == nullptr || lateAuthoredUes_.count(ueModule))
+        return;
+    for (const AuthoredBearer& ab : authoredBearers_)
+        if (ab.ueModule == ueModule)
+            return;  // authored at initialization
+    lateAuthoredUes_.insert(ueModule);
+
+    std::map<cModule *, std::vector<MacNodeId>> ueNodeIds;
+    for (const auto& [nodeId, info] : binder_->getNodeInfoMap())
+        if (getNodeTypeById(nodeId) == UE && info.moduleRef == ueModule)
+            ueNodeIds[ueModule].push_back(nodeId);
+    if (ueNodeIds.empty())
+        return;
+
+    std::string networkPrefix = std::string(getSystemModule()->getFullPath()) + ".";
+    std::map<cModule *, std::map<DrbId, DrbDesc>> drbsOfUe;  // stays empty: no static bearers here
+    size_t first = authoredBearers_.size();
+    parseDrbDefinitions("onDemandDrbs", true, ueNodeIds, networkPrefix, drbsOfUe);
+    for (size_t i = first; i < authoredBearers_.size(); i++)
+        computeUseSdapHeader(authoredBearers_[i].desc);
+    EV << "BearerConfigurator::ensureBearersAuthored - authored " << (authoredBearers_.size() - first)
+       << " on-demand definition(s) for late UE " << ueModule->getFullPath() << endl;
+}
